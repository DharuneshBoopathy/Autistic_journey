# =============================================================================
# The Autistic Journey / Gallery — environment template
#
# Copy to `.env.local` and fill in. NEVER commit `.env.local` or any real value.
# `.gitignore` excludes `.env*` except this file.
#
# Anything that must stay secret must NOT be prefixed NEXT_PUBLIC_ — that prefix
# inlines the value into the client bundle, where it is public by definition.
# =============================================================================

# --- Database ----------------------------------------------------------------
# Postgres connection string. Neon/Supabase both work; sslmode=require in prod.
DATABASE_URL="postgresql://user:password@localhost:5432/autistic_journey"

# --- Session -----------------------------------------------------------------
# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this invalidates every active session.
SESSION_SECRET=""

# --- Storage -----------------------------------------------------------------
#
# Recommended for the development stage: put BOTH on Cloudflare R2's free tier.
# It allows 10 GB with zero egress fees, which matters because a gallery serves a
# great many small images. At ~4 MB per original that is roughly 2,500 photos —
# derivatives are ~130 KB each and barely register.
#
#   STORAGE_DERIVATIVES_DRIVER="r2"
#   STORAGE_ORIGINALS_DRIVER="r2"
#
# When the archive outgrows that, move ONLY the originals — they are the bulk, and
# members never download them, so they can live on slow storage:
#
#   STORAGE_ORIGINALS_DRIVER="gdrive"    # or a paid R2 tier
#
# No code changes either way; the adapters isolate the difference.
#
# "local" is for tests and offline work. It is not durable, and the app refuses to
# start in production if it is selected.
STORAGE_DERIVATIVES_DRIVER="local"
STORAGE_ORIGINALS_DRIVER="local"

# Root directory for the "local" driver.
STORAGE_LOCAL_PATH="./var/storage"

# Soft ceiling on total stored bytes. Default 9 GB — just under R2's 10 GB free
# tier, so uploads are refused with an explanation before the provider starts
# failing with something that looks like a transient error.
# Raise this once storage is paid for.
STORAGE_SOFT_QUOTA_BYTES="9663676416"

# --- Cloudflare R2 (S3-compatible) -------------------------------------------
# The bucket MUST NOT have public access enabled. Bytes are served only through
# the app's authorization-checked route.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# --- Google Drive (cold storage for originals) -------------------------------
# Only needed if STORAGE_ORIGINALS_DRIVER="gdrive".
#
# Consumer Google One has no shared drives, so a service account cannot own files;
# an OAuth refresh token for the owning account is required instead. That token
# breaks on password or 2FA changes, which is an availability risk worth knowing
# about before relying on it for the only copy of anything.
GDRIVE_CLIENT_ID=""
GDRIVE_CLIENT_SECRET=""
GDRIVE_REFRESH_TOKEN=""
GDRIVE_FOLDER_ID=""

# --- Application -------------------------------------------------------------
# Canonical origin, used for absolute URLs and cookie scoping.
APP_ORIGIN="http://localhost:3000"

# Days a soft-deleted photo stays recoverable before permanent purge.
DELETED_RETENTION_DAYS="30"

# Max accepted upload size, bytes (default 50 MB).
MAX_UPLOAD_BYTES="52428800"
