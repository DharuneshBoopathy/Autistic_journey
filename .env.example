# ==============================================================================
# The Autistic Journey - Master Environment Configuration
# ==============================================================================
# Replace all placeholder values below with your environment-specific secrets.
# DO NOT commit real secrets or credentials to version control.

# --- AWS Configuration ---
AWS_REGION=ap-south-1
S3_MEDIA_BUCKET_NAME=replace-with-your-media-bucket-name
S3_WEB_BUCKET_NAME=replace-with-your-web-hosting-bucket-name
CLOUDFRONT_DISTRIBUTION_ID=replace-with-your-cloudfront-id
CLOUDFRONT_DOMAIN=replace-with-your-cloudfront-domain.cloudfront.net

# --- Domain & DNS ---
DOMAIN_NAME=example.com
WEBSITE_SUBDOMAIN=gallery.example.com
API_SUBDOMAIN=api.example.com
SSL_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/replace-with-cert-id

# --- Backend Application ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=replace-with-a-64-character-random-hex-string
DATABASE_URL=postgresql://db_user:db_password@db-host:5432/taj_gallery

# --- Frontend Build Parameters ---
API_BASE_URL=https://api.example.com
FLUTTER_WEB_RENDERER=canvaskit
