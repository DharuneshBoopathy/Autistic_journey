# Environment Configuration for The Autistic Journey Backend
# Copy to .env for local development with your actual values

# Application
PROJECT_NAME="The Autistic Journey API"
ENVIRONMENT=development
DEBUG=true
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:8080","http://localhost:50000","http://127.0.0.1:3000"]

# Security & Authentication (Generate secure random secrets in production)
# e.g., openssl rand -hex 32
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
# e.g., postgresql://postgres:password@localhost:5432/taj_gallery
# Fallback: sqlite:///./taj_dev.db for local offline testing
DATABASE_URL=sqlite:///./taj_dev.db

# AWS Configuration (IAM Role preferred in production; use credentials only for local dev)
AWS_REGION=ap-south-1
S3_BUCKET_NAME=replace-with-your-s3-bucket-name
# AWS credentials only needed if not running under IAM Role:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
S3_PRESIGNED_EXPIRY_SECONDS=900

# CloudFront CDN (optional, for accelerated media delivery)
CLOUDFRONT_DOMAIN=
